# ---------------------------------------------------------------------------
# Copier ce fichier en `.env` puis remplacer TOUTES les valeurs d'exemple.
# .env n'est jamais commité (voir backend/.gitignore).
# ---------------------------------------------------------------------------

# Base Neon (PostgreSQL). Utiliser l'URL « POOLED » (le domaine contient -pooler) :
# elle supporte les connexions courtes du mode serverless.
# Exemple : postgresql://user:MDP@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL= "postgresql://neondb_owner:npg_mRLUNuwvA8b5@ep-billowing-shadow-b5osoy3h-pooler.c-7.us-east-2.aws.neon.tech/PortfolioAKE?sslmode=require&channel_binding=require"

# Secret du signe JWT : au moins 32 caractères aléatoires.
# Genérer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET= "7c30c906af116330715987ff8941eba73962b8d04e2813c452a574777badd0e2b8a137a46a7ef22786ff0c5471a5dd0515dd78788c08e4817f13eee64da1e38e"
JWT_TTL="15m"

# Premier compte admin (créé automatiquement au démarrage, ou via `npm run seed:admin`).
ADMIN_EMAIL="akedev@gmail.com"
ADMIN_PASSWORD="akedev10@gmail.com"

# Ports et origines. Liste séparée par des virgules : le dashboard admin ET le site public.
# Exemple en production : https://donovane.dev,https://admin.donovane.dev
CORS_ORIGINES="http://localhost:5175,http://localhost:5173"
PORT=3001

# production | autre valeur = mode développement
NODE_ENV="development"

# Dossier des images importées depuis le dashboard (optionnel, défaut : ./uploads).
# En production, pointer vers un disque persistant si l'hébergeur est éphémère.
# DOSSIER_UPLOADS="uploads"
